//Example config. Replace this file with `config.json` in ~/.config/adb-sync-tool/. 
// Add aliases for each pair of files you want to sync: e.g.
{
"my_music": {
    "local_dir": "/local/path/to/my/music",
    "remote_dir": "/path/on/android/to/music/folder",
    //change this to `true` if you want to allow files/directories
    // with a dot starting in the name (e.g. /.config/)
    "allow_hidden": false,
    // Delete the next line if only one device is plugged in and
    // you don't want to bother figuring out the device name.
    // Otherwise, use the command `ast devices` to list the names
    // of all plugged in android devices.
    "device_name": "some-id-like-12345678"
},
"my_pictures": {
    //If you remove the the first `/` in `local_dir`, this will 
    //automatically prepend `/home/{user}/`, e.g.:
    "local_dir": "relative/path/to/my/picures",
    "remote_dir": "/path/on/android/to/pictures/folder",
    "allow_hidden": true
}

}
